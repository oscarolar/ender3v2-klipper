# Klipper firmware for the Ender 3 V2, board V4.2.2 (STM32F103 or GD32F303):
# 28 KiB bootloader, serial on USART1 (PA10/PA9) at 250000 baud.
# Build on the Klipper host: cp to ~/klipper/.config && make olddefconfig && make
CONFIG_LOW_LEVEL_OPTIONS=y
CONFIG_MACH_STM32=y
CONFIG_MACH_STM32F103=y
CONFIG_STM32_FLASH_START_7000=y
CONFIG_STM32_SERIAL_USART1=y
CONFIG_SERIAL_BAUD=250000
